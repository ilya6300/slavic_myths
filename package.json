{
  "name": "slavic-myths",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron && electron-builder --win portable",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:quiz": "node scripts/generate-quiz.mjs",
    "process:illustrations": "node scripts/process-illustration-drafts.mjs",
    "copy:illustrations": "node scripts/copy-illustration-drafts.mjs"
  },
  "dependencies": {
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "games.slavicmyths.desktop",
    "productName": "Книга славянских духов",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
